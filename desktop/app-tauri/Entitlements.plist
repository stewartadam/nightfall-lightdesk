<!-- Entitlements for the signed macOS app. The release workflow signs with the same keys; keep them in sync. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the hardened runtime open audio inputs, which LTC timecode input reads. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
