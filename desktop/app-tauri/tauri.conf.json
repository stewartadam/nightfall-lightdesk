{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightfall",
  "version": "0.1.0-alpha.4",
  "identifier": "com.stewartadam.nightfall",
  "build": {
    "beforeBuildCommand": {
      "script": "pnpm run build",
      "cwd": "../../webui"
    },
    "beforeDevCommand": {
      "script": "node ../scripts/distribution-notices.mjs --development && pnpm run dev",
      "cwd": "../../webui"
    },
    "frontendDist": "../../webui/dist",
    "devUrl": "http://localhost:3031",
    "beforeBundleCommand": {
      "script": "node ../scripts/package-sample-audio.mjs --check",
      "cwd": "../../webui"
    }
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "nightfall",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://nightfall.live/api/v1/updates/alpha/{{target}}/{{arch}}/{{bundle_type}}/{{current_version}}"
      ],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "GraphicsAndDesign",
    "copyright": "(C) 2026 Stewart Adam",
    "license": "MPL-2.0",
    "resources": {
      "../../webui/dist/notices": "notices",
      "../../crates/app-runtime/assets/sample-audio/": "sample-audio/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A modern lighting controller",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": "Entitlements.plist"
    }
  }
}
