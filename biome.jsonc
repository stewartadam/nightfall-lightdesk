{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!crates/app-runtime/tests/data/procedural-showfile-parse-data.json",
      // Generated by the GDTF bench tests (NIGHTFALL_GDTF_BENCH_UPDATE=1).
      "!crates/fixture-library/tests/gdtf-bench/expectations"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineEnding": "auto"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": "off",
        "noSvgWithoutTitle": "off",
        "useButtonType": "off",
        "noStaticElementInteractions": "off",
        "noNoninteractiveElementToInteractiveRole": "off",
        "useSemanticElements": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              // Solid 2.0 removes these; webui/lib/solid-compat.ts has the 2.0 form.
              "solid-js": {
                "importNames": [
                  "on",
                  "createComputed",
                  "createResource",
                  "createEffect"
                ],
                "message": "Solid 2.0 removes or reshapes this API. Use the two-function createEffect, createTrackedEffect or createProjection from webui/lib/solid-compat, or createAsyncValue from webui/lib/async-value."
              }
            }
          }
        }
      },
      "correctness": {
        "useJsxKeyInIterable": "off",
        "useHookAtTopLevel": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      // The compat module implements the Solid 2.0 shapes with the 1.x APIs they replace.
      "includes": ["webui/lib/solid-compat.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      // Specs read the text a user sees through Playwright, where innerText respects
      // layout and visibility; textContent would change what they assert.
      "includes": ["webui/e2e/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    }
  ]
}
