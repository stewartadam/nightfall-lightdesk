# Windows scripts - must be CRLF
*.ps text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Linux scripts - must be LF
*.sh text eol=lf
*.Dockerfile text eol=lf
Dockerfile text eol=lf
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads
# Bundled sample media is stored outside Git object history.
crates/app-runtime/assets/sample-audio/*.mp3 filter=lfs diff=lfs merge=lfs -text
# The browser demo showfile is stored gzip-compressed in plain Git; keep it binary.
webui/public/nightfall-demo.nightfall-show/showfile.json.gz binary
