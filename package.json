{
  "name": "nightfall-ui",
  "type": "module",
  "version": "0.0.1",
  "license": "MPL-2.0",
  "scripts": {
    "notices:desktop": "node scripts/distribution-notices.mjs",
    "build": "vite build",
    "build:browser-demo": "npm run wasm-build && npm run build:browser-demo:prepared",
    "build:browser-demo:prepared": "npm run generate:browser-demo-audio && vite build --mode browser-demo --base=/demo/app/ && node scripts/package-browser-demo-artifact.mjs && npm run report:browser-demo-size",
    "dev": "vite dev",
    "worktree:dashboard": "node worktree-dashboard/worktree-dashboard.mjs",
    "worktree:dashboard:api": "node worktree-dashboard/worktree-dashboard.mjs",
    "worktree:dashboard:watch": "node --watch worktree-dashboard/worktree-dashboard.mjs",
    "worktree:dashboard:ui": "vite dev --open /worktree-dashboard.html",
    "worktree:mcp": "node worktree-dashboard/worktree-dashboard-mcp.mjs",
    "fx-module:install": "node scripts/install-fx-module.mjs",
    "generate:showfile-parse-data": "cargo run -p nightfall-app --bin sample-data-showfile-parse-data --",
    "generate:browser-demo-audio": "node scripts/generate-browser-demo-audio.mjs",
    "start": "vite dev",
    "tauri": "tauri",
    "test:webui-node": "node scripts/run-webui-node-tests.mjs",
    "test:scripts": "node --test scripts/*.node.test.mjs",
    "playwright:install": "node scripts/run-playwright.mjs install chromium firefox",
    "report:browser-demo-size": "node scripts/report-browser-demo-size.mjs",
    "package:browser-demo": "node scripts/package-browser-demo-artifact.mjs",
    "test:webui-playwright": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 node scripts/run-playwright.mjs test",
    "test:webui-smoke": "npm run test:webui-playwright -- webui/e2e/startup-recovery-real-backend.spec.ts webui/e2e/showfile-menu.spec.ts webui/e2e/command-palette.spec.ts webui/e2e/tanstack-patch-fixture-list.spec.ts webui/e2e/clip-go-button.spec.ts",
    "test:browser-demo-artifact": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 NIGHTFALL_PLAYWRIGHT_VITE_MODE=preview node scripts/run-playwright.mjs test --target embedded-demo webui/e2e/browser-demo.spec.ts webui/e2e/distribution-notices.spec.ts",
    "test:browser-demo-artifact-soak": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 NIGHTFALL_PLAYWRIGHT_VITE_MODE=preview NIGHTFALL_BROWSER_DEMO_SOAK=1 node scripts/run-playwright.mjs test --target embedded-demo webui/e2e/browser-demo-soak.spec.ts",
    "test:browser-demo-soak": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 NIGHTFALL_BROWSER_DEMO_SOAK=1 node scripts/run-playwright.mjs test webui/e2e/browser-demo-soak.spec.ts",
    "test:webui-playwright:headed": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 node scripts/run-playwright.mjs test --headed",
    "test:webui-playwright:ui": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 node scripts/run-playwright.mjs test --ui",
    "check:command-architecture": "node scripts/check-command-architecture.mjs",
    "check:browser-demo-dependencies": "node scripts/check-browser-demo-dependencies.mjs",
    "check:crate-boundaries": "node scripts/check-crate-boundaries.mjs",
    "test": "npm run test:scripts && npm run test:webui-node",
    "autofix:rs": "cargo fmt && cargo clippy --all-features --fix --allow-dirty",
    "autofix:ts": "npx @biomejs/biome check --unsafe --write webui/ scripts/ && npm run typecheck",
    "autofix": "npm run autofix:ts && npm run autofix:rs",
    "lint": "npx @biomejs/biome check webui/ --formatter-enabled=false",
    "typecheck": "tsc -b --noEmit",
    "typeshare": "typeshare --lang typescript crates/ --output-file webui/types/index.ts",
    "wasm-build": "npx wasm-pack build --target web --out-dir ../../webui/assets/wasm crates/wasm-bridge && npm run wasm-build:browser-demo",
    "wasm-build:dev": "npx wasm-pack build --dev --target web --out-dir ../../webui/assets/wasm crates/wasm-bridge && npm run wasm-build:browser-demo:dev",
    "wasm-build:browser-demo": "npx wasm-pack build --target web --out-dir ../../webui/assets/browser-runtime crates/browser-runtime",
    "wasm-build:browser-demo:dev": "npx wasm-pack build --dev --target web --out-dir ../../webui/assets/browser-runtime crates/browser-runtime",
    "tauri-dev": "npm run tauri dev -- -- --no-default-features",
    "tauri-build": "npm run tauri build -- -- --no-default-features",
    "tauri-build:dev": "npm run tauri build -- -d -- --no-default-features",
    "knip": "knip"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@dschz/solid-flow": "^0.2.6",
    "@loglayer/shared": "^4.2.0",
    "@nanostores/deepmap": "^1.0.0",
    "@nanostores/logger": "^1.1.0",
    "@nanostores/persistent": "^1.3.4",
    "@nanostores/solid": "^1.0.0",
    "@neodrag/solid": "^2.3.0",
    "@solid-primitives/context": "^0.3.2",
    "@solid-primitives/scheduled": "^1.5.2",
    "@squidlab/phosphor-solid": "^1.1.2",
    "@tailwindcss/vite": "^4.1.6",
    "@tanstack/solid-table": "^9.1.2",
    "@tanstack/solid-virtual": "^3.13.24",
    "@tauri-apps/api": "^2.4.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "cborg": "^6.1.0",
    "colorjs.io": "^0.7.1",
    "comlink": "^4.4.2",
    "dockview": "^8.3.1",
    "dotenv-expand": "^12.0.3",
    "fkill": "^10.0.3",
    "loglayer": "^9.1.0",
    "nanostores": "^1.0.1",
    "nouislider": "^15.8.1",
    "pid-port": "^2.0.1",
    "preline": "^4.1.3",
    "serialize-error": "^13.0.1",
    "solid-js": "^1.9.11",
    "tailwindcss": "^4.1.4",
    "three": "^0.185.1",
    "tinykeys": "^4.0.0",
    "toastify-js": "^1.12.0",
    "uuid": "^14.0.0",
    "wavesurfer.js": "^7.9.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@j178/prek": "^0.5.0",
    "@playwright/cli": "^0.1.1",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2.4.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@types/toastify-js": "^1.12.4",
    "knip": "^6.6.2",
    "tw-animate-css": "^1.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.6",
    "wasm-pack": "^0.15.0"
  }
}
