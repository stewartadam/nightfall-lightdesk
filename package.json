{
  "name": "nightfall-ui",
  "type": "module",
  "version": "0.0.1",
  "license": "MPL-2.0",
  "packageManager": "pnpm@12.6.0",
  "//": "When adding, renaming or removing a script, update the script table in CONTRIBUTING.md.",
  "scripts": {
    "autofix": "pnpm run autofix:ts && pnpm run autofix:rs",
    "autofix:rs": "cargo fmt && cargo clippy --all-features --fix --allow-dirty",
    "autofix:ts": "biome check --unsafe --write webui/ scripts/ && pnpm run typecheck",
    "build": "vite build && node scripts/check-distribution-wasm.mjs native",
    "check:browser-demo-dependencies": "node scripts/check-browser-demo-dependencies.mjs",
    "check:command-architecture": "node scripts/check-command-architecture.mjs",
    "check:crate-boundaries": "node scripts/check-crate-boundaries.mjs",
    "dashboard": "node worktree-dashboard/worktree-dashboard.mjs",
    "dashboard:mcp": "node worktree-dashboard/worktree-dashboard-mcp.mjs",
    "dashboard:ui": "vite dev --open /worktree-dashboard.html",
    "demo:build": "pnpm run wasm && pnpm run demo:bundle",
    "demo:bundle": "node scripts/copy-browser-demo-audio.mjs && vite build --mode browser-demo --base=/demo/app/ && node scripts/check-distribution-wasm.mjs browser-demo && node scripts/package-browser-demo-artifact.mjs && node scripts/report-browser-demo-size.mjs",
    "demo:soak": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 NIGHTFALL_PLAYWRIGHT_VITE_MODE=preview NIGHTFALL_BROWSER_DEMO_SOAK=1 node scripts/run-playwright.mjs test --target embedded-demo webui/e2e/browser-demo-soak.spec.ts",
    "demo:test": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 NIGHTFALL_PLAYWRIGHT_VITE_MODE=preview node scripts/run-playwright.mjs test --target embedded-demo webui/e2e/browser-demo.spec.ts webui/e2e/distribution-notices.spec.ts",
    "dev": "vite dev",
    "fx-module:install": "node scripts/install-fx-module.mjs",
    "gdtf:bench": "cargo test -p nightfall-fixture-library --lib gdtf_bench -- --ignored",
    "gdtf:corpus": "cargo test --release -p nightfall-fixture-library --lib gdtf_corpus -- --ignored --nocapture",
    "gdtf:fetch": "node scripts/fetch-gdtf-bench.mjs",
    "knip": "knip",
    "lint": "biome check webui/ --formatter-enabled=false",
    "package:notices": "node scripts/distribution-notices.mjs",
    "package:sample-audio": "node scripts/package-sample-audio.mjs",
    "playwright:install": "node scripts/run-playwright.mjs install chromium firefox",
    "tauri": "tauri",
    "test": "pnpm run test:scripts && pnpm run test:webui-node",
    "test:scripts": "node --test scripts/*.node.test.mjs",
    "test:webui-hmr": "pnpm run test:webui-playwright --vite-mode dev webui/e2e/design-lab-hmr.spec.ts webui/e2e/connection-overlay-layering.spec.ts",
    "test:webui-node": "node scripts/run-webui-node-tests.mjs",
    "test:webui-playwright": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 node scripts/run-playwright.mjs test",
    "test:webui-smoke": "pnpm run test:webui-playwright webui/e2e/startup-recovery-real-backend.spec.ts webui/e2e/showfile-menu.spec.ts webui/e2e/command-palette.spec.ts webui/e2e/tanstack-patch-fixture-list.spec.ts webui/e2e/clip-go-button.spec.ts",
    "typecheck": "tsc -b --noEmit",
    "typeshare": "typeshare --lang typescript crates/ --output-file webui/types/index.ts",
    "visualizer:perf": "NIGHTFALL_TIMELINE_AUDIO_ENABLED=0 NIGHTFALL_OPTICAL_PLAYBACK_PERF=1 node scripts/run-playwright.mjs test --target embedded-demo webui/e2e/optical-playback-perf.spec.ts",
    "wasm": "node scripts/build-wasm.mjs bridge demo",
    "wasm:bridge": "node scripts/build-wasm.mjs bridge",
    "wasm:demo": "node scripts/build-wasm.mjs demo"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dschz/solid-flow": "^0.2.6",
    "@floating-ui/dom": "^1.8.0",
    "@loglayer/shared": "^4.4.0",
    "@nanostores/deepmap": "^1.0.0",
    "@nanostores/logger": "^1.1.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/solid": "^1.1.1",
    "@neodrag/solid": "^2.3.1",
    "@solid-primitives/context": "^0.3.2",
    "@solid-primitives/keyed": "^1.5.3",
    "@solid-primitives/scheduled": "^1.5.3",
    "@squidlab/phosphor-solid": "^1.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-table": "^9.2.4",
    "@tanstack/solid-virtual": "^3.13.40",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.2",
    "cborg": "^6.1.2",
    "colorjs.io": "^0.7.1",
    "comlink": "^4.4.2",
    "dockview": "^8.3.1",
    "dockview-core": "^8.3.1",
    "dotenv-expand": "^12.0.3",
    "fkill": "^10.0.3",
    "loglayer": "^9.4.0",
    "nanostores": "^1.5.4",
    "nouislider": "^15.8.1",
    "pid-port": "^2.1.2",
    "preline": "^5.0.0",
    "serialize-error": "^13.0.1",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tinykeys": "^4.0.1",
    "toastify-js": "^1.12.0",
    "uqr": "^0.1.3",
    "uuid": "^14.0.2",
    "wavesurfer.js": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@j178/prek": "^0.5.3",
    "@playwright/cli": "^0.1.21",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/toastify-js": "^1.12.4",
    "knip": "^6.38.0",
    "magic-string": "^0.30.21",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "wasm-pack": "^0.15.0",
    "yaml": "^2.9.1"
  }
}
