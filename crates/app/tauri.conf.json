{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightfall",
  "version": "0.1.0-alpha.1",
  "identifier": "com.stewartadam.nightfall",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../webui"
    },
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../webui"
    },
    "features": ["tauri", "full", "beatgrid-detect"],
    "frontendDist": "../../webui/dist",
    "devUrl": "http://localhost:3031"
  },
  "app": {
    "windows": [
      {
        "title": "nightfall",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "GraphicsAndDesign",
    "copyright": "(C) 2026 Stewart Adam",
    "license": "MPL-2.0",
    "resources": {
      "../../webui/dist/notices": "notices"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A modern lighting controller",
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
