{
  "id": "novation.launchpad",
  "name": "Novation Launchpad",
  "ports": {
    "match": ["launchpad"],
    "exclude": ["mk2", "mk3", "pro", "launchpad x"]
  },
  "feedback": true,
  "init": [[176, 0, 0], [176, 0, 40]],
  "release": [[176, 0, 0]],
  "colors": [
    { "name": "Off", "value": 12, "swatch": "#1f1f1f" },
    { "name": "Dim red", "value": 13, "swatch": "#7a1d14" },
    { "name": "Red", "value": 15, "swatch": "#ff2a1a" },
    { "name": "Dim green", "value": 28, "swatch": "#17661f" },
    { "name": "Green", "value": 60, "swatch": "#2cff3c" },
    { "name": "Dim amber", "value": 29, "swatch": "#7a5a14" },
    { "name": "Amber", "value": 63, "swatch": "#ffb21a" },
    { "name": "Yellow", "value": 62, "swatch": "#e2ff1a" },
    { "name": "Orange", "value": 47, "swatch": "#ff6a1a" },
    { "name": "Red flashing", "value": 11, "swatch": "#ff2a1a", "blink": true },
    {
      "name": "Green flashing",
      "value": 56,
      "swatch": "#2cff3c",
      "blink": true
    },
    {
      "name": "Amber flashing",
      "value": 59,
      "swatch": "#ffb21a",
      "blink": true
    }
  ],
  "defaults": { "off": "Off", "on": "Green", "held": "Amber flashing" }
}
