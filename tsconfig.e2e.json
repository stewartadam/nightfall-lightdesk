{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "/*": ["./webui/*"]
    }
  },
  "include": [
    "webui/e2e/**/*.ts",
    "webui/**/*.d.ts",
    "scripts/playwright-backend-pool.mjs"
  ],
  "exclude": []
}
